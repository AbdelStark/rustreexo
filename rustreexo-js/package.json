{
  "name": "@rustreexo/js",
  "version": "0.4.0",
  "description": "JavaScript/TypeScript SDK for Rustreexo - A dynamic accumulator for the UTXO set",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "build:watch": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "utreexo",
    "bitcoin",
    "accumulator",
    "cryptography",
    "merkle-tree",
    "wasm",
    "typescript"
  ],
  "author": "@AbdelStark",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mit-dci/rustreexo"
  },
  "homepage": "https://github.com/mit-dci/rustreexo",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "eslint": "^8.37.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "tsup": "^6.7.0",
    "typescript": "^5.0.2"
  },
  "dependencies": {
    "@rustreexo/wasm": "file:../rustreexo-wasm/pkg",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "js-sha512": "^0.9.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "sideEffects": false,
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
